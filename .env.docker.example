# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.

# Session signing key — REQUIRED. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Public URL of the app = your Cloudflare Tunnel hostname. REQUIRED.
# Baked into the client bundle at build time (absolute redirects like logout),
# so it MUST match the public hostname you configure on the tunnel.
NEXT_PUBLIC_APP_URL=https://stecopro.example.com

# Cloudflare Tunnel token — REQUIRED for the cloudflared service.
# Zero Trust dashboard → Networks → Tunnels → (your tunnel) → install token.
TUNNEL_TOKEN=

# Web push — OPTIONAL. App degrades gracefully without these (no push, rest works).
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:magnushj@steco.no
